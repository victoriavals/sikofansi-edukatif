# Templat. Salin menjadi tahap4/lokal_pribadi.env (di-ignore git) dan isi sesuai mesin Anda.
# Dibaca oleh model_prep/research_ollama.sh dan model_prep/services.ps1. Kunci API tetap di tahap4/.env.

# Biner Ollama yang dipakai instans riset (127.0.0.1:11435)
OLLAMA_BIN=/path/to/ollama
# Layanan Windows yang perlu dijeda selama run model lokal agar GPU eksklusif (pisahkan dengan koma, urutan berhenti);
# kosongkan bila tidak ada layanan lain yang memakai GPU
PAUSE_SERVICES=
# Server Ollama lain di mesin ini dan model yang dimuat kembali setelah layanan menyala (opsional)
PROVIDER_BASE_URL=http://127.0.0.1:11434
PROVIDER_RESTORE_MODEL=
